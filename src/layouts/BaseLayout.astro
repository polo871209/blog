---
import Document from "./Document.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  section: string;
}
const { title, section } = Astro.props;
---
<Document title={title}>
  <div class="page">
    <Nav section={section} />
    <main class="content">
      <slot />
      <Footer />
    </main>
  </div>
</Document>
